APP_NAME=GOLaundry
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Bahasa pesan validasi -> lang/id/validation.php
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------- Database MariaDB dari XAMPP ----------
# Buat dulu database "golaundry_laravel" di phpMyAdmin.
# Bawaan XAMPP: user root, password kosong. Sesuaikan kalau punyamu beda.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=golaundry_laravel
DB_USERNAME=root
DB_PASSWORD=

# Session disimpan di file (storage/framework/sessions), bukan di database,
# jadi database tetap berisi 6 tabel GOLaundry saja.
# LIFETIME = menit tanpa aktivitas sebelum otomatis logout.
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
